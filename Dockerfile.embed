FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt ./

RUN python -m pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install sentence-transformers numpy einops \
               azure-storage-blob azure-storage-queue \
               qdrant-client scikit-learn tqdm

COPY src ./src

# Bake the embedding model into the image. Downloading it from HuggingFace on
# every replica start costs ~500MB of egress per replica and adds a network
# failure mode to a job that has no log destination to diagnose it with.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('nomic-ai/nomic-embed-text-v1.5', trust_remote_code=True)"

# Default: process messages from queue until empty
CMD ["python", "-m", "src.indexing.worker", "--loop"]
