# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is required to run the test suite -- tests mock external
# services. These are needed to run the API, the eval harnesses, or the
# embedding backfill against real infrastructure.

# ── Vector store ─────────────────────────────────────────────────────────────
# The API refuses to start its warmup path without QDRANT_URL set.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=books

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Used by the RAG /ask endpoint (src/rag/generate.py), the LLM relevance judge
# (src/eval/judge.py), and corpus-grounded query generation (src/eval/query_gen.py).
# All three read these with os.getenv and raise a clear error if unset; /ask turns
# that into a 502 with the detail attached, so search is unaffected.
# AZURE_OPENAI_API_KEY is accepted as a fallback for AZURE_OPENAI_KEY.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-54-nano

# ── Evaluation ───────────────────────────────────────────────────────────────
# Point the eval harnesses at a different API (defaults to the deployed URL,
# so set this to http://localhost:8000 when evaluating a local build).
EVAL_API_URL=http://localhost:8000

# ── Embedding backfill (src/indexing/worker.py, assemble.py) ────────────────
# The work queue and object store are pluggable. Default = Kafka (runs on
# Kubernetes) + Azure Blob (managed object store; Azurite emulator locally).
# Set QUEUE_BACKEND=azure for the reference ACA + Storage Queue path, or
# OBJECT_STORE_BACKEND=s3 to use the optional S3/MinIO backend.
QUEUE_BACKEND=kafka           # kafka | azure
OBJECT_STORE_BACKEND=azure    # azure | s3

# Kafka (QUEUE_BACKEND=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=embed-tasks
KAFKA_GROUP_ID=embed-workers
KAFKA_PARTITIONS=6
KAFKA_IDLE_TIMEOUT=30         # seconds of empty polls before a --loop worker exits

# Azure Blob (OBJECT_STORE_BACKEND=azure) and/or Storage Queue (QUEUE_BACKEND=azure).
# Connection string contains an account key -- never commit a real one.
# For local dev, point at the Azurite emulator with its well-known dev account
# (public, not a secret):
#   AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=
QUEUE_NAME=embed-tasks
STORAGE_CONTAINER=embeddings
SHARD_PREFIX=shards

# S3 / MinIO (OBJECT_STORE_BACKEND=s3) -- optional, portable alternative.
S3_BUCKET=embeddings
S3_ENDPOINT_URL=http://localhost:9000   # unset for real AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Worker tuning. EMBED_BATCH_SIZE is the knob that matters: the backfill was
# OOM-killed at higher values on a 2 GiB container.
EMBED_DIM=256
EMBED_BATCH_SIZE=32
EMBED_MAX_SEQ_LEN=1024
BATCH_CHUNK_SIZE=500
EMBED_OUTPUT_MODE=blob
TIER_FILTER=1

# ── Observability (OpenTelemetry tracing) ────────────────────────────────────
# Tracing is OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set. When set, the API
# and worker export spans over OTLP/HTTP to a collector — docker-compose runs
# Jaeger (UI at http://localhost:16686). Standard OTEL_* env vars are honoured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=booksearch-api
# OTEL_SDK_DISABLED=false

# ── Local development ────────────────────────────────────────────────────────
# Set to skip the model-loading warmup on API start (faster iteration).
# DISABLE_WARMUP=1

# ── Frontend (web/.env.local, not this file) ─────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated extra origins added to the default localhost list.
# CORS_ORIGINS=https://black-grass-0df1c7a0f.7.azurestaticapps.net
