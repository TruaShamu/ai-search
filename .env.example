# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is required to run the test suite -- tests mock external
# services. These are needed to run the API, the eval harnesses, or the
# embedding backfill against real infrastructure.

# ── Vector store ─────────────────────────────────────────────────────────────
# The API refuses to start its warmup path without QDRANT_URL set.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=books

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Used by query expansion (src/query/expansion.py), the RAG /ask endpoint,
# the LLM relevance judge, and corpus-grounded query generation.
# Query expansion reads these with os.environ[...] and will raise if unset;
# the eval components degrade to a clear error instead.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-54-nano

# ── Evaluation ───────────────────────────────────────────────────────────────
# Point the eval harnesses at a different API (defaults to the deployed URL,
# so set this to http://localhost:8000 when evaluating a local build).
EVAL_API_URL=http://localhost:8000

# ── Embedding backfill (scripts/embed_worker.py, assemble_shards.py) ─────────
# Storage account connection string. Contains an account key -- never commit.
AZURE_STORAGE_CONNECTION_STRING=
QUEUE_NAME=embed-tasks
STORAGE_CONTAINER=embeddings
SHARD_PREFIX=shards

# Worker tuning. EMBED_BATCH_SIZE is the knob that matters: the backfill was
# OOM-killed at higher values on a 2 GiB container.
EMBED_DIM=256
EMBED_BATCH_SIZE=32
EMBED_MAX_SEQ_LEN=1024
BATCH_CHUNK_SIZE=500
EMBED_OUTPUT_MODE=blob
TIER_FILTER=1

# ── Local development ────────────────────────────────────────────────────────
# Set to skip the model-loading warmup on API start (faster iteration).
# DISABLE_WARMUP=1

# ── Frontend (web/.env.local, not this file) ─────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
