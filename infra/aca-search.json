{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "12711364699705245036"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "containerAppEnvironmentName": {
      "type": "string",
      "defaultValue": "booksearch-aca-env",
      "metadata": {
        "description": "Azure Container Apps managed environment name."
      }
    },
    "qdrantAppName": {
      "type": "string",
      "defaultValue": "qdrant",
      "metadata": {
        "description": "Qdrant Container App name."
      }
    },
    "apiAppName": {
      "type": "string",
      "defaultValue": "booksearch-api",
      "metadata": {
        "description": "FastAPI Container App name."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "booksearchblobs",
      "metadata": {
        "description": "Azure Storage account name used for the Qdrant Azure Files share."
      }
    },
    "createStorageAccount": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set to true to create the storage account in this deployment. Leave false to use an existing account."
      }
    },
    "fileShareName": {
      "type": "string",
      "defaultValue": "qdrant-data",
      "metadata": {
        "description": "Azure Files share name used for Qdrant persistence."
      }
    },
    "acrName": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry name."
      }
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry login server, for example myregistry.azurecr.io."
      }
    },
    "apiImageName": {
      "type": "string",
      "metadata": {
        "description": "API image name including tag, for example booksearch-api:latest."
      }
    },
    "azureOpenAIEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI endpoint for the API."
      }
    },
    "azureOpenAIKey": {
      "type": "securestring",
      "metadata": {
        "description": "Azure OpenAI API key for the API."
      }
    },
    "qdrantExternalIngress": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether Qdrant ingress is external (set true for initial data migration, false for prod)."
      }
    }
  },
  "variables": {
    "storageAccountId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "apiImage": "[format('{0}/{1}', parameters('acrLoginServer'), parameters('apiImageName'))]"
  },
  "resources": [
    {
      "condition": "[parameters('createStorageAccount')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowSharedKeyAccess": true,
        "minimumTlsVersion": "TLS1_2"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('fileShareName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppEnvironmentName')]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', parameters('containerAppEnvironmentName'), 'qdrant-storage')]",
      "properties": {
        "azureFile": {
          "accountName": "[parameters('storageAccountName')]",
          "accountKey": "[listKeys(variables('storageAccountId'), '2023-05-01').keys[0].value]",
          "accessMode": "ReadWrite",
          "shareName": "[parameters('fileShareName')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', split(format('{0}/default/{1}', parameters('storageAccountName'), parameters('fileShareName')), '/')[0], split(format('{0}/default/{1}', parameters('storageAccountName'), parameters('fileShareName')), '/')[1], split(format('{0}/default/{1}', parameters('storageAccountName'), parameters('fileShareName')), '/')[2])]",
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('qdrantAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": "[parameters('qdrantExternalIngress')]",
            "targetPort": 6333,
            "transport": "http"
          }
        },
        "template": {
          "containers": [
            {
              "name": "qdrant",
              "image": "qdrant/qdrant:latest",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "volumeMounts": [
                {
                  "volumeName": "qdrant-data",
                  "mountPath": "/qdrant/storage"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "qdrant-data",
              "storageType": "AzureFile",
              "storageName": "qdrant-storage"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('containerAppEnvironmentName'), 'qdrant-storage')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('apiAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "http"
          },
          "registries": [
            {
              "server": "[parameters('acrLoginServer')]",
              "username": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-07-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-07-01').passwords[0].value]"
            },
            {
              "name": "azure-openai-key",
              "value": "[parameters('azureOpenAIKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "booksearch-api",
              "image": "[variables('apiImage')]",
              "env": [
                {
                  "name": "QDRANT_URL",
                  "value": "http://qdrant:80"
                },
                {
                  "name": "QDRANT_COLLECTION",
                  "value": "books"
                },
                {
                  "name": "AZURE_OPENAI_ENDPOINT",
                  "value": "[parameters('azureOpenAIEndpoint')]"
                },
                {
                  "name": "AZURE_OPENAI_API_KEY",
                  "secretRef": "azure-openai-key"
                },
                {
                  "name": "AZURE_OPENAI_KEY",
                  "secretRef": "azure-openai-key"
                },
                {
                  "name": "PYTHONPATH",
                  "value": "/app"
                }
              ],
              "resources": {
                "cpu": 1,
                "memory": "2Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 3
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "[resourceId('Microsoft.App/containerApps', parameters('qdrantAppName'))]"
      ]
    }
  ],
  "outputs": {
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('apiAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "qdrantInternalUrl": {
      "type": "string",
      "value": "[format('http://{0}', parameters('qdrantAppName'))]"
    },
    "qdrantExternalUrl": {
      "type": "string",
      "value": "[if(parameters('qdrantExternalIngress'), format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('qdrantAppName')), '2024-03-01').configuration.ingress.fqdn), 'internal-only')]"
    },
    "containerAppEnvironmentResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]"
    }
  }
}