# Secrets
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Data — large files excluded from git.
# Note: the directory contents are globbed rather than the directory itself,
# because git cannot re-include a file whose parent directory is excluded.
data/processed/*
data/index/
data/models/

# ...but the spell dictionary is a small build input the API image needs.
# Without it, spell correction silently falls back to a generic English
# wordlist and loses every book title/author term.
!data/processed/corpus_dictionary.txt

# Keep eval dataset (small, curated)
!data/eval/
data/eval/results.json

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Node (web frontend)
web/node_modules/
web/.next/

# Notebooks — checkpoints
.ipynb_checkpoints/

# Eval v2. Ship the evidence behind the README numbers -- the query set, the
# relevance labels, and the computed metrics -- so the results are auditable
# and `--step eval` can be re-run without paying to re-judge. The pooled
# candidate file is 3MB and regenerable from the queries via `--step pool`.
data/eval/v2/*
!data/eval/v2/queries_grounded.json
!data/eval/v2/judgments.json
!data/eval/v2/results.json
!data/eval/v2/human.json
!data/eval/v2/human.meta.json
!data/eval/v2/human_random.json
!data/eval/v2/human_random.meta.json

# The ranked lists each mode produced are the one part of the eval that cannot
# be recovered offline: the pool and the judgments are stored, but the ordering
# is not, and it disappears the moment the corpus is reindexed. Committing it
# (107KB) keeps the v1 threshold-sensitivity numbers verifiable afterwards.
!data/eval/v2/rankings_v1.json
!data/eval/v2/threshold_sensitivity.json
